# -----------------------------------------------------------------------
# .env.example — Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# -----------------------------------------------------------------------

# NVIDIA NIM API key (get yours at https://integrate.api.nvidia.com)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# NIM Chat Completions endpoint (default works for most models)
NV_LLM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Model to use for grounded generation
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Runtime mode. Set to production only in a locked-down deployment.
APP_ENV=development
PYTHONUNBUFFERED=1
CHROMA_PATH=./vectorstore
DATA_DIR=./data

# Backend API
FLASK_PORT=5000
TOP_K=3
OUT_OF_SCOPE_MAX_SCORE=0.65
APP_DEBUG=0
CORS_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
API_AUTH_TOKEN=
API_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=32768
REDIS_URL=redis://localhost:6379/0
REQUIRE_REDIS=0
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Frontend
FLASK_API_URL=http://127.0.0.1:5000
FLASK_API_KEY=
GRADIO_PORT=7860
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SHARE=0

# Retrieval
RETRIEVAL_MODE=dense
ALLOW_EXTRACTIVE_FALLBACK=1
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=0.5
